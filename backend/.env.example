# ==============================================================================
# FinPilot AI Environment Variables Configuration
# ==============================================================================

# Backend Security
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Database
DATABASE_URL=sqlite:///./finpilot.db

# Google Gemini API Key
# Leave blank to use the built-in Offline Financial Reasoning Engine.
GEMINI_API_KEY=

# Server Config
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
