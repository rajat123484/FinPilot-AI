# ==============================================================================
# FinPilot AI Environment Variables Configuration
# ==============================================================================

# Backend Security
SECRET_KEY=finpilot-super-secret-jwt-key-2026-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Database
DATABASE_URL=sqlite:///./finpilot.db

# Google Gemini API Key
# Optional: If left blank or unset, FinPilot AI automatically activates its
# built-in Offline Financial Reasoning Engine for instant demo execution.
GEMINI_API_KEY=

# Server Config
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
